# Example environment for the internal C0 Speech Inference API.
# Copy locally. Do not commit machine paths or credentials.

# YAML consumed by src.c0_cascaded. Point this at a local/RunPod file that
# already contains ASR/MT checkpoint paths. Do not put checkpoints in Git.
C0_INFERENCE_CONFIG=/absolute/path/to/c0_inference.yaml

# Bind internally. The Go backend authenticates citizens; this process is not
# a public GPU endpoint.
SPEECH_HOST=127.0.0.1
SPEECH_PORT=8090

# Empty keeps the device from C0_INFERENCE_CONFIG. Values: cpu | cuda | auto
SPEECH_DEVICE=

# Entire HTTP request body, including multipart boundaries/headers — not
# only the WAV payload. C0 CLI max_audio_bytes still applies to files.
SPEECH_MAX_UPLOAD_BYTES=10485760
SPEECH_MAX_AUDIO_SECONDS=30
# Step 7.4 is single-flight. Values other than 1 are rejected.
SPEECH_MAX_INFLIGHT=1
SPEECH_REQUEST_TIMEOUT_S=120
SPEECH_SHUTDOWN_TIMEOUT_S=30
SPEECH_LOG_LEVEL=INFO
SPEECH_WORKERS=1
SPEECH_FAIL_FAST=true

# Service-to-service token. Same pattern as AI_SERVICE_TOKEN.
# Go backend will send Authorization: Bearer <token>.
# SPEECH_AUTH=off is accepted only when SPEECH_HOST is loopback.
SPEECH_AUTH=on
SPEECH_SERVICE_TOKEN=replace-with-a-long-random-token
