# Speech (Bahnar C0 on RunPod) for the local Docker stack.
# Copy to deploy/.env.speech.local (gitignored via .env.*.local) and fill in.
# Without .env.speech.local, ./scripts/up.sh starts everything except Speech.

# Go API → speech-tunnel sidecar (same network namespace, loopback only).
SPEECH_ENABLED=true
SPEECH_SERVICE_URL=http://127.0.0.1:18090
# Same value as SPEECH_SERVICE_TOKEN on the RunPod Speech process (>= 16 chars).
SPEECH_SERVICE_TOKEN=
SPEECH_TIMEOUT_MS=130000
# Whole-body cap. Must be 65537..10485760 (above 64 KiB multipart reserve).
SPEECH_MAX_UPLOAD_BYTES=10485760
SPEECH_MAX_INFLIGHT=1

# RunPod "SSH over exposed TCP" from the pod Connect panel: ssh root@<ip> -p <port>.
# The ssh.runpod.io proxy does not support port forwarding.
# A new pod changes ip/port: update these and run ./scripts/up.sh again.
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=
RUNPOD_SSH_USER=root
# Absolute path on this machine to the private key registered with RunPod.
RUNPOD_SSH_KEY_PATH=
# Port the Speech API binds on the pod (scripts/runpod/run_speech_api.sh).
RUNPOD_SPEECH_PORT=8090
