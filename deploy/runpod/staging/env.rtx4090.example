# RunPod "Edit Pod" environment for cas-aio on the existing RTX 4090 pod
# (volume buppvu4d48 at /workspace). Values marked {{ RUNPOD_SECRET_... }} are
# RunPod Secrets: create them first (Console > Secrets), never paste the value here.
# Every other service setting (Postgres, Qdrant, MinIO, nginx) is fixed by
# entrypoint.sh: they bind 127.0.0.1, data under /workspace/cas, nginx on 8088.

# Mode: Speech C0 on the GPU. Fail-closed checks: checkpoints manifest, config, HF cache, nvidia-smi.
CAS_SPEECH_MODE=gpu

# Secrets (entrypoint.sh enforces the minimum length and refuses placeholders).
# Generate each with: openssl rand -hex 32   (64 hex chars, no newline, URL-safe)
JWT_SECRET={{ RUNPOD_SECRET_CAS_JWT_SECRET }}
AI_SERVICE_TOKEN={{ RUNPOD_SECRET_CAS_AI_SERVICE_TOKEN }}
SPEECH_SERVICE_TOKEN={{ RUNPOD_SECRET_CAS_SPEECH_SERVICE_TOKEN }}
# Applied once, at the first Postgres init on this volume. Keep a copy outside RunPod.
POSTGRES_PASSWORD={{ RUNPOD_SECRET_CAS_POSTGRES_PASSWORD }}
# MINIO_ROOT_USER: >= 8 chars, e.g. "cas-" + openssl rand -hex 8; must not contain "minioadmin".
MINIO_ROOT_USER={{ RUNPOD_SECRET_CAS_MINIO_ROOT_USER }}
MINIO_ROOT_PASSWORD={{ RUNPOD_SECRET_CAS_MINIO_ROOT_PASSWORD }}

# LLM (same models as deploy/.env)
LLM_PROVIDER=gemini
GEMINI_API_KEY={{ RUNPOD_SECRET_CAS_GEMINI_API_KEY }}
LLM_MODEL_EXTRACTION=gemini-3.5-flash-lite
LLM_MODEL_DEFINITION=gemini-3.8-flash

# E5 embedding: fp32 runs on the EPYC 7B13 (AVX2, no AVX-512 VNNI) and on any host
# the pod may move to. Model: /workspace/cas/models/embedding (pod_stage.sh apply).
EMBEDDING_VARIANT=fp32

# Speech C0 files (defaults written out; prepared by pod_stage.sh apply)
C0_INFERENCE_CONFIG=/workspace/cas/config/c0_inference.yaml
SPEECH_TIMEOUT_MS=90000

# Do NOT set: SPEECH_ENABLED (derived from CAS_SPEECH_MODE), EMBEDDING_CPU_FLAGS
# (tests only, refused), CAS_ALLOW_MOCK_LLM, APP_ENV, DATABASE_URL (all derived).
