# Environment of the all-in-one pod (RunPod template "Environment Variables").
# Names only: put every secret in RunPod Secrets and reference it as
#   {{ RUNPOD_SECRET_<name> }}
# Never commit real values. entrypoint.sh refuses empty, short or placeholder values.

# Required. off = CPU smoke (Speech not started, no checkpoints); gpu = staging.
CAS_SPEECH_MODE=gpu

# Required secrets (minimum length enforced by entrypoint.sh)
JWT_SECRET=                 # >= 32 chars
AI_SERVICE_TOKEN=           # >= 16 chars
POSTGRES_PASSWORD=          # >= 16 chars, password of DB role "cas" (set once at first init)
MINIO_ROOT_USER=            # >= 8 chars
MINIO_ROOT_PASSWORD=        # >= 16 chars
SPEECH_SERVICE_TOKEN=       # >= 16 chars, required when CAS_SPEECH_MODE=gpu

# LLM: required, no default. gemini | openai | mock (mock only with CAS_ALLOW_MOCK_LLM=true, tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=             # required when LLM_PROVIDER=gemini
LLM_MODEL_EXTRACTION=gemini-3.5-flash-lite
LLM_MODEL_DEFINITION=gemini-3.8-flash

# Speech C0 (gpu mode). Files live on the network volume, prepared in 8.1-B.
#   /workspace/cas/config/c0_inference.yaml       operator YAML (from c0_inference.example.yaml)
#   /workspace/cas/manifests/c0_checkpoints.sha256 sha256sum lines with absolute paths
#   /workspace/cas/hf-cache                       tokenizer cache (offline)
# C0_INFERENCE_CONFIG=/workspace/cas/config/c0_inference.yaml
# ARTIFACT_ROOT=/workspace/bahnar-s2tt-thesis
# SPEECH_TIMEOUT_MS=90000      # must stay <= 95000 (RunPod proxy cuts at 100 s)

# Optional overrides (defaults shown are set by entrypoint.sh)
# XA_ID=xa_chu_se
# OBJECT_STORAGE_BUCKET=cas-documents
# EMBEDDING_PROVIDER=onnx       # model at /workspace/cas/models/embedding
# EMBEDDING_VARIANT=fp32        # fp32 (default, any x86_64/arm64) | int8-vnni (needs AVX-512 VNNI) | auto
# OCR_PROVIDER=tesseract
# CAS_BOOTSTRAP_TIMEOUT_S=300
# CAS_BACKUP_KEEP=7
# CAS_LEASE_HEARTBEAT_S=10   # workspace lease heartbeat
# CAS_LEASE_STALE_S=60       # data services refuse to start on an older heartbeat
