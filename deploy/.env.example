# Optional local overrides for Docker Compose (copy → deploy/.env).
# Go API local DSN: apps/api/configs/local/config.yaml — do NOT put DATABASE_URL here.
#
# Prod / LLM secrets: set on VPS at deploy (or put real keys only in local .env, never commit).

POSTGRES_USER=cas
POSTGRES_PASSWORD=cas
POSTGRES_DB=citizen_assistance
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Uncomment when using real LLM (never commit real keys)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
LLM_PROVIDER=mock
