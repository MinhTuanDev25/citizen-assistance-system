# Optional local overrides for Docker Compose (copy → deploy/.env).
# Go API local DSN: apps/api/configs/local/config.yaml — do NOT put DATABASE_URL here.
#
# Prod / LLM secrets: set on VPS at deploy (or put real keys only in local .env, never commit).

POSTGRES_USER=cas
POSTGRES_PASSWORD=cas
POSTGRES_DB=citizen_assistance
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Uncomment when using real LLM (never commit real keys)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
LLM_PROVIDER=mock

# --- P2 LLM Extract wiring (Go API -> apps/ai-service) ---------------------
# Disabled by default: with AI_EXTRACT_ENABLED unset/false the API runs the
# original keyword-only decision engine, byte-for-byte, no network call ever
# happens. Requires zero API keys locally: LLM_PROVIDER=mock (above) needs no
# secret and is what apps/ai-service uses when these are turned on.
AI_EXTRACT_ENABLED=false
AI_SERVICE_URL=http://ai-service:8001
# Shared by the Go API and ai-service. Not an LLM key. Override outside local dev.
AI_SERVICE_TOKEN=local-dev-ai-service-token
AI_EXTRACT_TIMEOUT_MS=3000
AI_INTENT_SELECT_MIN=0.82
AI_INTENT_CONFIRM_MIN=0.55
AI_SLOT_CONFIDENCE_MIN=0.6
# ai-service only. Payload ceilings are hard limits in Pydantic, not env vars.
EXTRACT_RATE_PER_MINUTE=60
EXTRACT_MAX_INFLIGHT=4
EXTRACT_RETRY_AFTER_SECONDS=1

# Admin PDF intake. Off by default, so the API does not wait on MinIO and
# the web build keeps the "chưa triển khai" screen.
# Both flags must be true together, then rebuild web:
#   ADMIN_INGESTION_ENABLED=true VITE_ADMIN_INGESTION=true \
#     docker compose --profile app --profile storage up --build
ADMIN_INGESTION_ENABLED=false
VITE_ADMIN_INGESTION=false
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=cas-documents
OBJECT_STORAGE_USE_SSL=false
DOCUMENT_MAX_BYTES=20971520

# P4A indexing foundation. Off unless ingestion is also on.
# Mock worker only: no OCR, embedding, RAG, or activate.
# cd deploy && ADMIN_INGESTION_ENABLED=true VITE_ADMIN_INGESTION=true ADMIN_INDEXING_ENABLED=true VITE_ADMIN_INDEXING=true \
#   docker compose --profile app --profile storage --profile ai up --build
ADMIN_INDEXING_ENABLED=false
VITE_ADMIN_INDEXING=false
INDEX_CLAIM_TTL_SECONDS=30
INDEX_TIMEOUT_MS=3000
# Pipeline mode only. Claim TTL must exceed the pipeline timeout.
# INDEX_PIPELINE_TIMEOUT_SECONDS=120
# INDEX_CLAIM_TTL_SECONDS=180
# INDEX_PUBLISH_TIMEOUT_MS=10000

# P4B content pipeline. mock keeps the P4A worker. pipeline reads PDF from MinIO,
# writes staging chunks to Postgres and vectors to Qdrant. fake is an explicit
# local double and does not download weights. onnx and paddle fail startup
# unless the local directories match their manifests. Runtime never downloads models.
INDEX_MODE=mock
EMBEDDING_PROVIDER=fake
OCR_PROVIDER=fake
EMBEDDING_MODEL_DIR=/models/embedding
OCR_MODEL_DIR=/models/ocr
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_chunks
QDRANT_PORT=6333
