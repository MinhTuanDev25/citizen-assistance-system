# Copy to a secret store or a root-only file on the server. Do not commit the copy.
# docker compose -f docker-compose.production.yml refuses to render while any
# required value below is empty.

CAS_API_IMAGE=
CAS_AI_IMAGE=
CAS_WEB_IMAGE=

# postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full
DATABASE_URL=
JWT_SECRET=
AI_SERVICE_TOKEN=
XA_ID=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_USE_SSL=true

QDRANT_URL=
QDRANT_COLLECTION=knowledge_chunks

# Host directories that contain the pinned model manifests and weights.
EMBEDDING_MODEL_DIR=
OCR_MODEL_DIR=

# Leave false until Phase 6 supplies a real provider and a runtime key.
AI_EXTRACT_ENABLED=false
LLM_PROVIDER=mock
ADMIN_INGESTION_ENABLED=false
ADMIN_INDEXING_ENABLED=false

# Rebuild the web image with matching Vite args when those flags are true:
#   docker build -f apps/web/Dockerfile \
#     --build-arg VITE_ADMIN_INGESTION=true \
#     --build-arg VITE_ADMIN_INDEXING=true \
#     -t cas-web:release .
INDEX_REAPER_INTERVAL_SECONDS=60
INDEX_REAPER_SHUTDOWN_SECONDS=30
INDEX_ORPHAN_GRACE_SECONDS=120
INDEX_CLEANUP_BATCH_SIZE=8
